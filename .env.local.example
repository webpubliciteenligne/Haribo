# Copier ce fichier en .env.local (dev) et renseigner les vraies valeurs dans Vercel (Production/Preview).
# Ne JAMAIS committer .env.local ni les vraies clés.

# --- Webhook de destination des leads (Make.com / Zapier -> Google Sheets / CRM) ---
LEADS_WEBHOOK_URL=

# --- Pixels Ads (côté client, NEXT_PUBLIC_ requis pour être exposés au bundle browser) ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Tracking server-side (dual tracking, recommandé — cf. plan) ---
# Généré dans Meta Events Manager > Paramètres > Conversions API > Générer un jeton d'accès.
META_CAPI_ACCESS_TOKEN=
# Généré dans TikTok Ads Manager > Events Manager > Events API > Generate Access Token.
TIKTOK_EVENTS_API_ACCESS_TOKEN=

# --- Backup DB optionnel (Vercel Postgres) ---
# Laisser vide pour désactiver le backup (le webhook reste le canal principal).
# Renseigné automatiquement par Vercel si vous liez un store Postgres au projet.
POSTGRES_URL=
